# Copie ce fichier en ".env" et renseigne tes propres valeurs
# (Supabase > Project Settings > API).
#
# Remarque : ce .env n'est pas lu automatiquement par le site (qui est du
# HTML/JS statique sans serveur de build), il sert de référence pour savoir
# quelles valeurs reporter manuellement dans public/js/config.js.
# Ne jamais committer le fichier ".env" une fois rempli (voir .gitignore).

SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre-cle-anon-publique
